@model IEnumerable<Forest.Data.Models.Domain.Music>

@{
    ViewData["Title"] = "Musics";
}

@* <h1>Musics</h1> *@

<p>
    <a asp-action="Create" asp-controller="MusicAdmin" class="btn btn-primary">Create New</a>
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="row g-0">
                    <!-- Left Side: Image -->
                    <div class="col-md-4">
                        <img src="@item.Image" class="img-fluid rounded-start" alt="Music Cover" style="width: 100%; height: auto; object-fit: cover;">
                    </div>

                    <!-- Right Side: Details -->
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">@item.Title</h5>
                            <p class="card-text"><strong>Tracks:</strong> @item.Tracks</p>
                            <p class="card-text"><strong>Duration:</strong> @item.minutes</p>
                            <p class="card-text"><strong>Release Date:</strong> @item.ReleaseDate.ToString("dd MMM yyyy")</p>
                            <p class="card-text"><strong>Price:</strong> $@item.price</p>

                            <div class="mt-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="GetMusic" asp-controller="Music" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
